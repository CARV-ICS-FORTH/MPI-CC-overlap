# Input parameters
mpi_path=/spare/michnik/ompi-5.0.4-install/
#mpi_path=/home1/public/michnik/apps/ofed-5.8/ompi/
num_of_mpiruns=3								# num of different mpiruns per benchmark
num_of_iterations=3000							# num of iterations within each benchmark per message size tried
num_of_benchmark_runs=30                                                # num of benchmark executions per message size tried (in the same mpirun)
max_msg_size=4194304							# maximum message size in bytes
noise_threshold=0.05							# deviation between min and max across different mpiruns not reporeted while it is below this threshold
mpirun_args="-np 2   --map-by hwthread"
#mpirun_args="--mca pml ucx -x UCX_NET_DEVICES=mlx5_0:1,mlx4_0:1 --mca btl ^vader,tcp,openib -np 2 --host  192.168.5.120,192.168.5.121"
